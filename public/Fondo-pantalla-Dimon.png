<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fondo-pantalla-dimon</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100%;
      background-color: #087bea;
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      overflow-x: hidden;
    }

    .contenedor-fondo {
      width: 308px;
      height: 548px;
      overflow: hidden;
      background-color: #087bea;
    }

    .imagen-fondo {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center center;
    }

    @media (max-width: 340px) {
      .contenedor-fondo {
        width: calc(100vw - 24px);
        height: auto;
        aspect-ratio: 308 / 548;
      }
    }
  </style>
</head>
<body>
  <main class="contenedor-fondo">
    <img
      class="imagen-fondo"
      src="./share_1788447307732.png"
      alt="Dimon Connect - Fondo de Pantalla"
      width="308"
      height="548"
    >
  </main>
</body>
</html>
