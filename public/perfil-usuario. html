<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Mi Perfil — Dimon Connect</title>
  
  <link rel="stylesheet" href="css/variables.css">
  <link rel="stylesheet" href="css/global.css">
  <link rel="stylesheet" href="css/componentes.css">
  <link rel="stylesheet" href="css/responsivo.css">
</head>
<body>

  <header>
    <button class="boton-volver" onclick="window.location.href='index.html'" data-txt="volver">← Volver</button>
    <h2>👤 Mi Perfil</h2>
  </header>

  <main class="contenedor-perfil">
    <div class="tarjeta-perfil">
      <div class="avatar-grande">👤</div>
      <h3 id="perfil-nombre">Usuario Anónimo</h3>
      <p id="perfil-correo" class="correo-perfil">Sin correo registrado</p>
      <span class="estado-perfil">● No ha iniciado sesión</span>
    </div>

    <div class="acciones-perfil">
      <button id="boton-iniciar" class="boton-principal">🔑 Iniciar Sesión</button>
      <button id="boton-registrar" class="boton-secundario">📝 Registrarse</button>
      <button id="boton-mis-ofertas" class="boton-secundario" style="display:none;">📋 Mis Servicios Ofrecidos</button>
      <button id="boton-mis-solicitudes" class="boton-secundario" style="display:none;">📋 Mis Solicitudes</button>
      <button id="boton-cerrar-sesion" class="boton-peligro" style="display:none;">🚪 Cerrar Sesión</button>
    </div>

    <div class="seccion-datos" id="seccion-datos-personales" style="display:none;">
      <h4>📝 Mis Datos</h4>
      <form id="formulario-perfil">
        <div class="grupo-formulario">
          <label>Nombre Completo</label>
          <input type="text" id="editar-nombre">
        </div>
        <div class="grupo-formulario">
          <label>Correo Electrónico</label>
          <input type="email" id="editar-correo">
        </div>
        <div class="grupo-formulario">
          <label>Teléfono / WhatsApp</label>
          <input type="tel" id="editar-telefono">
        </div>
        <button type="submit" class="boton-principal">💾 Guardar Cambios</button>
      </form>
    </div>
  </main>

  <script>
    function actualizarPerfil() {
      const usuario = JSON.parse(localStorage.getItem('usuario-actual') || 'null');
      if (usuario) {
        document.getElementById('perfil-nombre').textContent = usuario.nombre || 'Usuario';
        document.getElementById('perfil-correo').textContent = usuario.correo || '';
        document.querySelector('.estado-perfil').textContent = '● Conectado';
        document.getElementById('boton-iniciar').style.display = 'none';
        document.getElementById('boton-registrar').style.display = 'none';
        document.getElementById('boton-cerrar-sesion').style.display = 'block';
        document.getElementById('boton-mis-ofertas').style.display = 'block';
        document.getElementById('boton-mis-solicitudes').style.display = 'block';
        document.getElementById('seccion-datos-personales').style.display = 'block';
        
        document.getElementById('editar-nombre').value = usuario.nombre || '';
        document.getElementById('editar-correo').value = usuario.correo || '';
        document.getElementById('editar-telefono').value = usuario.telefono || '';
      }
    }

    document.getElementById('boton-cerrar-sesion').addEventListener('click', function() {
      localStorage.removeItem('usuario-actual');
      location.reload();
    });

    document.getElementById('formulario-perfil').addEventListener('submit', function(e) {
      e.preventDefault();
      const usuario = JSON.parse(localStorage.getItem('usuario-actual') || '{}');
      usuario.nombre = document.getElementById('editar-nombre').value;
      usuario.correo = document.getElementById('editar-correo').value;
      usuario.telefono = document.getElementById('editar-telefono').value;
      localStorage.setItem('usuario-actual', JSON.stringify(usuario));
      alert('✅ Datos guardados correctamente');
      actualizarPerfil();
    });

    actualizarPerfil();
  </script>

  <script src="js/idioma.js"></script>
  <script src="js/almacenamiento.js"></script>
  <script src="js/validacion.js"></script>
  <script src="js/trato.js"></script>
  <script src="js/flujos.js"></script>
</body>
</html>
