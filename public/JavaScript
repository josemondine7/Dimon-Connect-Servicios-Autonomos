// ====================== REGISTRAR USUARIO ======================
async function registrarUsuario(correo, contraseña, nombre, pais, ciudad) {
  try {
    if (!supabase) return { exito: false, mensaje: "Base de datos no conectada" };
    
    const { data: authData, error: authError } = await supabase.auth.signUp({
      email: correo,
      password: contraseña
    });
    if (authError) throw authError;

    const { error: perfilError } = await supabase.from('usuarios').insert([{
      id: authData.user.id,
      correo: correo,
      nombre: nombre,
      pais: pais,
      ciudad: ciudad,
      fecha_registro: new Date(),
      rol: 'usuario'
    }]);
    if (perfilError) throw perfilError;

    return { exito: true, mensaje: '¡Registro exitoso! Bienvenido a Dimon Connect.' };
  } catch (error) {
    return { exito: false, mensaje: error.message };
  }
}

// ====================== INICIAR SESIÓN ======================
async function iniciarSesion(correo, contraseña) {
  try {
    if (!supabase) return { exito: false, mensaje: "No conectado" };
    const { data, error } = await supabase.auth.signInWithPassword({
      email: correo,
      password: contraseña
    });
    if (error) throw error;
    localStorage.setItem('usuarioActivo', JSON.stringify(data.user));
    return { exito: true, mensaje: '¡Bienvenido de vuelta!' };
  } catch (error) {
    return { exito: false, mensaje: error.message };
  }
}

// ====================== CERRAR SESIÓN ======================
async function cerrarSesion() {
  if (supabase) await supabase.auth.signOut();
  localStorage.removeItem('usuarioActivo');
  window.location.href = 'index.html';
}

// ====================== VERIFICAR SESIÓN ======================
function verificarSesion() {
  const usuario = localStorage.getItem('usuarioActivo');
  return usuario ? JSON.parse(usuario) : null;
}

// ====================== PAYPAL — BOTÓN DE PAGO ======================
function inicializarBotonPago(monto, descripcion, servicioId) {
  if (typeof paypal === 'undefined') {
    console.error("PayPal SDK no cargado");
    return;
  }
  paypal.Buttons({
    style: { layout: 'vertical', color: 'gold', shape: 'rect', label: 'pay' },
    createOrder: (data, actions) => {
      return actions.order.create({
        purchase_units: [{
          amount: { value: monto.toString(), currency_code: 'USD' },
          description: descripcion
        }]
      });
    },
    onApprove: async (data, actions) => {
      await actions.order.capture();
      alert("✅ ¡Pago realizado con éxito!");
      window.location.href = `confirmacion.html?servicio=${servicioId}`;
    },
    onError: (err) => {
      console.error("Error de pago:", err);
      alert("⚠️ Hubo un problema. Intentá nuevamente.");
    }
  }).render('#boton-paypal');
}

