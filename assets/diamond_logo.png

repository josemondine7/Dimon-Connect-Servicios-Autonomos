<svg width="960" height="960" viewBox="0 0 960 960" xmlns="http://www.w3.org/2000/svg">
  <!-- Fondo crema exacto -->
  <rect width="960" height="960" fill="#F5F2E8"/>

  <!-- GRÁFICO DEL ROMBO — medidas y capas EXACTAS -->
  <g transform="translate(480, 360)">
    <!-- Capa 1: borde exterior azul muy oscuro -->
    <polygon 
      points="0,-110 110,0 0,110 -110,0" 
      fill="#0A1A30" 
      stroke="#000000" 
      stroke-width="1"
    />
    <!-- Capa 2: azul profundo -->
    <polygon 
      points="0,-95 95,0 0,95 -95,0" 
      fill="#0F2B66"
    />
    <!-- Capa 3: azul medio -->
    <polygon 
      points="0,-78 78,0 0,78 -78,0" 
      fill="#1548B3"
    />
    <!-- Capa 4: azul brillante / turquesa -->
    <polygon 
      points="0,-60 60,0 0,60 -60,0" 
      fill="#0099CC"
    />
    <!-- Capa 5: centro turquesa claro -->
    <polygon 
      points="0,-42 42,0 0,42 -42,0" 
      fill="#22D3EE"
    />
    <!-- Capa 6: centro brillante -->
    <polygon 
      points="0,-28 28,0 0,28 -28,0" 
      fill="#67F0F0"
    />
  </g>

  <!-- TEXTO EXACTO: Dimon Connect -->
  <text 
    x="480" 
    y="560" 
    font-family="Arial, 'Helvetica Neue', Helvetica, sans-serif" 
    font-size="72" 
    font-weight="700" 
    text-anchor="middle"
  >
    <tspan fill="#0A2463">Dimon </tspan>
    <tspan fill="#0094D9">Connect</tspan>
  </text>
</svg>
