import React from 'react';
import { StyleSheet, Text, View, Image, TextInput, TouchableOpacity, ScrollView, SafeAreaView } from 'react-native';
// Si usas Expo, esto viene preinstalado. Si no, usa react-native-linear-gradient
import { LinearGradient } from 'expo-linear-gradient';
import { Ionicons, MaterialCommunityIcons } from '@expo/vector-icons';

// Define tus colores exactos aquí
const COLORS = {
  bgGradientTop: '#1E40AF', // Azul oscuro
  bgGradientBottom: '#10B981', // Verde azulado
  borderCyan: '#22D3EE',
  textMain: '#FFFFFF',
  textSub: '#E5E7EB',
  buttonBg: '#111827', // Fondo de botón casi negro
};

export default function HomeScreen() {
  return (
    <SafeAreaView style={styles.container}>
      {/* 1. Fondo Degradado Base */}
      <LinearGradient
        colors={[COLORS.bgGradientTop, COLORS.bgGradientBottom]}
        style={StyleSheet.absoluteFill}
      />

      {/* 2. Superposición del Mapa Mundial (Imagen Transparente) */}
      <Image
        source={require('./assets/world_map_dots.png')} // TU IMAGEN DEL MAPA
        style={styles.mapOverlay}
        resizeMode="cover"
      />

      <ScrollView contentContainerStyle={styles.scrollContent}>
        {/* Header (Mimetizando la interfaz de chat) */}
        <View style={styles.header}>
          <Ionicons name="arrow-back" size={24} color="white" />
          <View style={styles.headerTextContainer}>
            <Text style={styles.headerTitle}>Tú</Text>
            <Text style={styles.headerSubTitle}>Ayer 9:44 p. m.</Text>
          </View>
          <Ionicons name="ellipsis-vertical" size={24} color="white" />
        </View>

        {/* 3. Logo del Diamante */}
        <View style={styles.logoContainer}>
          <Image
            source={require('./assets/diamond_logo.png')} // TU IMAGEN DEL LOGO
            style={styles.logoImage}
            resizeMode="contain"
          />
        </View>

        {/* Título de la App */}
        <Text style={styles.appTitle}>Dimon Connect</Text>
        <Text style={styles.appSubTitle}>Servicios Autónomos</Text>

        {/* 4. Buscador */}
        <View style={styles.searchContainer}>
          <Ionicons name="search" size={20} color={COLORS.borderCyan} style={styles.searchIcon} />
          <TextInput
            style={styles.searchInput}
            placeholder="¿Qué servicio necesitas hoy?"
            placeholderTextColor="#9CA3AF"
          />
        </View>

        {/* 5. Botones con Efecto de Brillo Cyan (Neon) */}
        {/* Botón 1 */}
        <TouchableOpacity style={styles.neonButtonContainer}>
          <LinearGradient
            colors={[COLORS.buttonBg, '#1F2937']} // Degradado interno sutil
            style={styles.neonButton}
          >
            <Text style={styles.buttonTextTitle}>¿NECESITÁS UN SERVICIO?</Text>
            <Text style={styles.buttonTextSub}>Encontrá ayuda cerca tuyo</Text>
          </LinearGradient>
          {/* Este view crea el borde cyan brillante exterior */}
          <View style={styles.neonBorder} />
        </TouchableOpacity>

        {/* Botón 2 */}
        <TouchableOpacity style={styles.neonButtonContainer}>
          <LinearGradient colors={[COLORS.buttonBg, '#1F2937']} style={styles.neonButton}>
            <Text style={styles.buttonTextSub}>¿Querés ofrecer tus servicios?</Text>
          </LinearGradient>
          <View style={styles.neonBorder} />
        </TouchableOpacity>

        {/* 6. Sección "Ofertas y Demandas" con Micrófono */}
        <TouchableOpacity style={styles.ofertasContainer}>
          {/* Icono Micrófono Flotante */}
          <View style={styles.micCircleContainer}>
            <LinearGradient colors={['#38BDF8', '#818CF8']} style={styles.micCircle}>
              <MaterialCommunityIcons name="microphone" size={28} color="white" />
            </LinearGradient>
            {/* Brillo exterior del mic */}
            <View style={styles.micNeonBorder} />
          </View>

          {/* Texto de la sección */}
          <View style={styles.ofertasTextContainer}>
            <Text style={styles.ofertasTitle}>Ofertas y Demandas</Text>
            <Text style={styles.ofertasSub}>Buscá servicios o publicá tu oferta</Text>
          </View>
        </TouchableOpacity>

        {/* 7. Texto Inferior */}
        <View style={styles.footerTextContainer}>
          <Text style={styles.footerLink}>Normas y Seguridad</Text>
          <Text style={styles.footerLink}>Actualizaciones</Text>
          <Text style={styles.footerLink}>Política de Privacidad</Text>
          <Text style={styles.footerText}>Descargar la aplicación Dimon Connect</Text>
          <Text style={styles.dolaAi}>Dola AI</Text>
        </View>

      </ScrollView>

      {/* 8. Barra de Respuesta Inferior */}
      <View style={styles.responderBar}>
        <TextInput style={styles.responderInput} placeholder="Responder" placeholderTextColor="#9CA3AF" />
        <View style={styles.emojiContainer}>
          <Text style={styles.emoji}>❤️</Text>
          <Text style={styles.emoji}>😂</Text>
          <MaterialCommunityIcons name="face-recognition" size={24} color="#9CA3AF" />
        </View>
      </View>
    </SafeAreaView>
  );
}

