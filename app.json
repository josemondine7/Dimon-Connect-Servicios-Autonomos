{
  "expo": {
    "name": "Dimon Connect",
    "slug": "dimon-connect",
    "version": "1.0.0","platforms": ["ios", "android","Web" ],

    "orientation": "portrait",
    "icon": "./assets/dimon_logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/dimon_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#3454CC"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android","web" : {
      "package": "com.dimon.connect",
      "versionCode": 1,
      "permissions": ["USE_BIOMETRIC", "INTERNET"]
    },
    "plugins": [
      ["expo-build-properties", { "android","Web": { "compileSdkVersion": 34, "targetSdkVersion": 34 } }]
    ]
  }
}
