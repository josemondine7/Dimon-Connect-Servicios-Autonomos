# ═════════════════════════════════════════════════════════════
# 🔐 DIMON CONNECT — VARIABLES DE ENTORNO
# Copia este archivo a .env y completa con tus valores reales
# NUNCA commits .env al repositorio
# ═════════════════════════════════════════════════════════════

# 🌐 Servidor
NODE_ENV=development
PORT=3000
RENDER_URL=http://localhost:3000

# 🗄️ Base de datos — Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE=your-service-role-key-here

# 🤖 IA Assistant — Groq
GROQ_API_KEY=your-groq-api-key-here

# 💳 Pagos — PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_MODE=sandbox

# 🔑 JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this

# 📧 Email (Opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# 📞 Twilio (Opcional - Para SMS/Llamadas)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# 🔗 URLs de frontend
FRONTEND_URL=http://localhost:3000
FRONTEND_PROD=https://dimon-connect.com

# 📊 Estadísticas (Opcional)
SENTRY_DSN=your-sentry-dsn
